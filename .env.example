# Copy to .env and fill in. Never commit the real .env.

# --- Supabase (Postgres + Storage) ---
# Project Settings -> API in the Supabase dashboard.
SUPABASE_URL=
# Service role key — server-side only, bypasses RLS. Used by one-time
# scripts (ingest-biodata) and the Fastify server. Never expose to a client.
SUPABASE_SERVICE_ROLE_KEY=

# --- Meta WhatsApp Cloud API (added in Phase 2) ---
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# --- Anthropic (added in Phase 3) ---
ANTHROPIC_API_KEY=

# --- Operator escalation number (added in Phase 4) ---
OPERATOR_WHATSAPP_NUMBER=+6580372668
